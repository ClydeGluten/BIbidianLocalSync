{
  "name": "local-vault-sync",
  "version": "2.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Authenticated local-network vault synchronization for Obsidian",
  "main": "main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-mobile-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@eslint/js": "^10.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "obsidian": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
